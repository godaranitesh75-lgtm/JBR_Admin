# Copy this file to .env for a local server. Never commit the .env file.
# Use the pooled Neon connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE-POOLER.REGION.aws.neon.tech/DBNAME?sslmode=require

# The initial administrator is inserted once when the API starts.
ADMIN_EMAIL=store-owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-secret-characters
PORT=3000
NODE_ENV=development

# Optional comma-separated website origins. The live storefront origin is allowed by default.
# Capacitor Android uses http://localhost, https://localhost, and capacitor://localhost.
CORS_ORIGINS=https://jbr-electrical.vercel.app
