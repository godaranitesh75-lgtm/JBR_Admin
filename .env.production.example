# Copy to .env.production.local before building the APK.
# These are public app defaults, not database credentials or API secrets.
# Use the same API that serves the JBR Electrical website.
VITE_PUBLIC_API_URL=https://jbrelec.onrender.com
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Set to true only for a device-local demo APK; this disables live API access.
VITE_LOCAL_DEMO_MODE=false
# Public unauthenticated catalog editing is dangerous; use only when explicitly intended.
VITE_PUBLIC_CATALOG_WRITES=false
