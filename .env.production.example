# Website build settings. Configure these in the hosting provider's build environment.
# They are public client settings, not database credentials or API secrets.
VITE_PUBLIC_API_URL=https://jbrelec.onrender.com
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Production builds must use the live API.
VITE_LOCAL_DEMO_MODE=false
# Keep unauthenticated catalog editing disabled.
VITE_PUBLIC_CATALOG_WRITES=false
