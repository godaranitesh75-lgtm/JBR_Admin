{
  "name": "jbr-electrical-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "dev:api": "tsx watch backend/index.ts",
    "build:server": "tsc -p backend/tsconfig.server.json",
    "build:web": "tsc -p frontend/tsconfig.app.json --noEmit && vite build --config frontend/vite.config.ts",
    "build": "tsc -b && vite build --config frontend/vite.config.ts && npm run build:server",
    "test:api": "tsx --test backend/index.test.ts",
    "start": "node server-dist/index.js",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0",
    "android:add": "npx cap add android --config frontend/capacitor.config.ts",
    "android:sync": "npm run build && npx cap sync android --config frontend/capacitor.config.ts",
    "android:open": "npx cap open android --config frontend/capacitor.config.ts",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
